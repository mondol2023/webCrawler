# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
CLIENT_URL=http://localhost:5173

# ─── Database ───────────────────────────────────────────────────────────────
#MONGO_URI=mongodb://localhost:27017/webcrawler

# ─── Redis (BullMQ) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-32-char-minimum-secret-value
JWT_REFRESH_SECRET=change-me-to-a-different-32-char-minimum-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Media downloader ───────────────────────────────────────────────────────
# Path to the yt-dlp binary. Omit to use `yt-dlp` from PATH.
#YTDLP_PATH=C:\tools\yt-dlp.exe

# Your own proxy/VPN endpoint, used when a site is blocked in this server's
# country. Credentials here are never written to the database.
#MEDIA_PROXY_URL=http://user:pass@host:8080

# Some sites (Instagram, X, private YouTube videos) refuse anonymous clients
# outright — even for public posts. These let the server present *your own*
# signed-in session; it can never reach anything that account cannot see.
# Export cookies.txt in Netscape format from a browser extension:
#YTDLP_COOKIES_FILE=C:\secrets\cookies.txt
# …or read them straight from a local browser profile (`chrome`, `firefox:default`):
#YTDLP_COOKIES_FROM_BROWSER=chrome

MONGODB_USERNAME=your-atlas-db-user
MONGODB_PASSWORD=your-atlas-db-password
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/webcrawler?retryWrites=true&w=majority&appName=<cluster>
